# Copie de référence. `npm run dev` (à la racine) crée backend/.env tout seul si absent.
# Manuellement : cp .env.example .env && node scripts/generate-secrets.mjs >> .env

DATABASE_URL="postgresql://certis:certis_password@localhost:5432/certis_db"
PORT=3001

# Secrets : générés par scripts/generate-secrets.mjs, jamais commités.
# JWT_SECRET="…"          (32 caractères minimum)
# ECDSA_PRIVATE_KEY="…"   (PEM PKCS#8, courbe P-256, "\n" littéraux acceptés)
