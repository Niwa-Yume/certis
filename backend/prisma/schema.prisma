// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Asset {
  id            String      @id @default(uuid())
  name          String
  brand         String
  model         String
  reference     String
  status        AssetStatus @default(ACTIVE)
  integrityHash String
  ownerId       String
  imageUrl      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  owner     User      @relation(fields: [ownerId], references: [id])
  nonces    AuthNonce[]
  transfers Transfer[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  assets         Asset[]
  issuedNonces   AuthNonce[] @relation("NonceIssuer")
  reservedNonces AuthNonce[] @relation("NonceRecipient")
}

// Un nonce est lié à un actif, à une finalité et au propriétaire qui l'a émis.
model AuthNonce {
  id         String       @id @default(uuid())
  nonceValue String       @unique
  purpose    NoncePurpose
  expiresAt  DateTime
  used       Boolean      @default(false)
  usedAt     DateTime? //horodatage au moment où le nonce a été consommé permet de vérifier que le nonce n'est pas réutilisé après son expiration (en gros traçabilité !!!)
  createdAt  DateTime     @default(now())

  assetId     String
  asset       Asset   @relation(fields: [assetId], references: [id])
  issuedById  String
  issuedBy    User    @relation("NonceIssuer", fields: [issuedById], references: [id])
  // Offre de transfert réservée à un destinataire (optionnel).
  recipientId String?
  recipient   User?   @relation("NonceRecipient", fields: [recipientId], references: [id])
}

enum NoncePurpose {
  VERIFY
  TRANSFER
}

model Transfer {
  id          String   @id @default(uuid())
  fromOwnerId String
  toOwnerId   String
  createdAt   DateTime @default(now())

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
}
